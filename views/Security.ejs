<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Security Verification - KIET Technologies</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
  :root {
    --primary:#2563eb; --primary-dark:#1e40af; --success:#16a34a;
    --danger:#ef4444; --warning:#f59e0b; --gray:#6b7280; --bg:#f1f5f9;
    --shadow:0 4px 24px rgba(0,0,0,.08); --radius:12px;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  body{font-family:"Inter","Segoe UI",sans-serif;background:var(--bg);color:#111827;min-height:100vh;}

  header{background:linear-gradient(135deg,#1e40af,#2563eb);color:#fff;display:flex;justify-content:space-between;align-items:center;padding:1rem 2rem;box-shadow:var(--shadow);}
  header img{height:70px;}
  .user-info{display:flex;align-items:center;gap:.75rem;}
  .avatar{width:42px;height:42px;border-radius:50%;background:rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center;font-weight:700;border:2px solid rgba(255,255,255,.4);}
  .logout-btn{background:var(--danger);color:#fff;border:none;padding:.5rem 1.1rem;border-radius:8px;cursor:pointer;font-weight:600;transition:.2s;}
  .logout-btn:hover{background:#dc2626;}

  .container{max-width:1400px;margin:32px auto;padding:0 1.5rem;}
  h2{font-size:1.9rem;font-weight:800;color:var(--primary-dark);margin-bottom:1.5rem;text-align:center;}

  /* toolbar */
  .toolbar{display:flex;gap:1rem;margin-bottom:1rem;align-items:center;flex-wrap:wrap;}
  .toolbar input{flex:1;min-width:220px;padding:.6rem 1rem;border:1.5px solid #e2e8f0;border-radius:8px;font-size:.95rem;outline:none;transition:.2s;}
  .toolbar input:focus{border-color:var(--primary);}
  .filter-btns{display:flex;gap:.4rem;}
  .fbtn{border:1.5px solid #e2e8f0;background:#fff;padding:.5rem .9rem;border-radius:8px;cursor:pointer;font-size:.85rem;font-weight:600;transition:.2s;}
  .fbtn.active,.fbtn:hover{background:var(--primary);color:#fff;border-color:var(--primary);}

  /* summary chips */
  .chips{display:flex;gap:.75rem;margin-bottom:1.25rem;flex-wrap:wrap;}
  .chip{background:#fff;border:1.5px solid #e2e8f0;border-radius:999px;padding:.35rem 1rem;font-size:.85rem;font-weight:600;display:flex;align-items:center;gap:.4rem;}
  .chip.pending{border-color:var(--warning);color:#92400e;background:#fffbeb;}
  .chip.receiving{border-color:#10b981;color:#065f46;background:#ecfdf5;}

  /* table */
  .table-wrap{background:#fff;border-radius:var(--radius);box-shadow:var(--shadow);overflow:auto;}
  table{width:100%;border-collapse:collapse;min-width:850px;}
  thead th{background:var(--primary-dark);color:#fff;padding:.85rem 1rem;text-align:left;font-size:.85rem;font-weight:600;white-space:nowrap;}
  thead th:first-child{border-radius:var(--radius) 0 0 0;}
  thead th:last-child{border-radius:0 var(--radius) 0 0;}
  tbody tr{border-bottom:1px solid #f1f5f9;transition:background .15s;}
  tbody tr:hover{background:#f8fafc;}
  tbody td{padding:.8rem 1rem;font-size:.88rem;vertical-align:middle;}

  /* status badge */
  .badge{display:inline-flex;align-items:center;gap:.3rem;padding:.28rem .7rem;border-radius:999px;font-size:.78rem;font-weight:700;}
  .badge-pending{background:#fef3c7;color:#92400e;}
  .badge-receiving{background:#d1fae5;color:#065f46;}

  /* action buttons */
  .actions{display:flex;gap:.4rem;flex-wrap:wrap;}
  .btn{border:none;padding:.4rem .85rem;border-radius:7px;font-size:.8rem;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;gap:.3rem;transition:.2s;white-space:nowrap;}
  .btn-primary{background:var(--primary);color:#fff;}.btn-primary:hover{background:var(--primary-dark);}
  .btn-success{background:var(--success);color:#fff;}.btn-success:hover{background:#15803d;}
  .btn-warning{background:var(--warning);color:#fff;}.btn-warning:hover{background:#d97706;}
  .btn-gray{background:#e2e8f0;color:#374151;}.btn-gray:hover{background:#cbd5e1;}
  .btn-danger{background:var(--danger);color:#fff;}.btn-danger:hover{background:#dc2626;}

  /* empty */
  .empty{text-align:center;padding:3rem;color:var(--gray);}
  .empty i{font-size:2.5rem;opacity:.35;display:block;margin-bottom:.75rem;}

  /* modal */
  .modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);backdrop-filter:blur(4px);z-index:2000;justify-content:center;align-items:flex-start;padding-top:40px;}
  .modal.open{display:flex;}
  .modal-box{background:#fff;border-radius:var(--radius);width:95%;max-width:860px;max-height:88vh;overflow-y:auto;box-shadow:0 20px 60px rgba(0,0,0,.2);animation:fadeUp .3s ease;}
  .modal-head{display:flex;justify-content:space-between;align-items:center;padding:1.1rem 1.5rem;border-bottom:1px solid #e2e8f0;position:sticky;top:0;background:#fff;z-index:1;}
  .modal-head h3{font-size:1.15rem;font-weight:700;color:var(--primary-dark);}
  .modal-body{padding:1.5rem;}
  .close-x{background:none;border:none;font-size:1.7rem;cursor:pointer;color:var(--gray);line-height:1;}
  .close-x:hover{color:var(--danger);}

  /* item table inside modal */
  .itbl{width:100%;border-collapse:collapse;margin-bottom:1.25rem;}
  .itbl th{background:var(--primary-dark);color:#fff;padding:.65rem .9rem;font-size:.82rem;text-align:left;}
  .itbl td{padding:.6rem .9rem;border-bottom:1px solid #f1f5f9;font-size:.85rem;}
  .itbl tbody tr:hover{background:#f8fafc;}
  .qty-inp{width:75px;padding:.35rem .45rem;border:1.5px solid #e2e8f0;border-radius:6px;text-align:center;font-size:.85rem;}
  .qty-inp:focus{outline:none;border-color:var(--primary);}
  input[type=checkbox]{width:16px;height:16px;cursor:pointer;accent-color:var(--primary);}

  /* GRN chip */
  .grn-chip{display:inline-flex;align-items:center;gap:.3rem;background:#ecfdf5;color:#065f46;border:1px solid #6ee7b7;border-radius:6px;padding:.2rem .6rem;font-size:.78rem;font-weight:700;font-family:monospace;}

  /* toast */
  .toast{position:fixed;top:1.25rem;right:1.25rem;padding:.9rem 1.4rem;border-radius:.75rem;box-shadow:var(--shadow);font-size:.95rem;opacity:0;transform:translateX(120%);transition:.4s;z-index:9999;color:#fff;max-width:340px;}
  .toast.show{opacity:1;transform:translateX(0);}
  .toast.error{background:var(--danger);}
  .toast.success{background:linear-gradient(135deg,var(--success),#22c55e);}

  .spinner{display:inline-block;width:32px;height:32px;border:4px solid #e2e8f0;border-top-color:var(--primary);border-radius:50%;animation:spin .8s linear infinite;}
  @keyframes fadeUp{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:translateY(0)}}
  @keyframes spin{to{transform:rotate(360deg)}}
</style>
</head>
<body>

<header>
  <img src="images/wt_img.png" alt="KIET Logo">
  <div class="user-info">
    <div class="avatar">SO</div>
    <span style="font-weight:600">Security Officer</span>
    <button class="logout-btn" onclick="logout()"><i class="fas fa-sign-out-alt"></i> Logout</button>
  </div>
</header>

<div class="container">
  <h2><i class="fas fa-shield-alt"></i> Security Verification</h2>

  <div class="chips">
    <div class="chip pending"><i class="fas fa-hourglass-half"></i> Pending: <strong id="cnt-pending">0</strong></div>
    <div class="chip receiving"><i class="fas fa-truck-loading"></i> Now Receiving: <strong id="cnt-receiving">0</strong></div>
  </div>

  <div class="toolbar">
    <input type="text" id="search-inp" placeholder="🔍  Search PO number or supplier..." oninput="renderTable()">
    <div class="filter-btns">
      <button class="fbtn active" id="fb-all"      onclick="setFilter('all')">All</button>
      <button class="fbtn"        id="fb-pending"  onclick="setFilter('pending')">Pending</button>
      <button class="fbtn"        id="fb-receiving" onclick="setFilter('receiving')">Now Receiving</button>
    </div>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>#</th>
          <th>PO Number</th>
          <th>Supplier</th>
          <th>Received Qty</th>
          <th>Pending Qty</th>
          <th>Project</th>
          <th>Amount</th>
          <th>Date</th>
          <th>Status</th>
          <th>GRNs</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody id="order-tbody">
        <tr><td colspan="11" style="text-align:center;padding:2rem"><div class="spinner"></div></td></tr>
      </tbody>
    </table>
  </div>
</div>

<!-- GRN Modal -->
<div class="modal" id="grnModal">
  <div class="modal-box">
    <div class="modal-head">
      <h3 id="grn-title">Add GRN</h3>
      <button class="close-x" onclick="closeGrn()">&times;</button>
    </div>
    <div class="modal-body" id="grn-body"></div>
  </div>
</div>

<!-- History Modal -->
<div class="modal" id="histModal">
  <div class="modal-box">
    <div class="modal-head">
      <h3 id="hist-title">GRN History</h3>
      <button class="close-x" onclick="closeHist()">&times;</button>
    </div>
    <div class="modal-body" id="hist-body"></div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
  let allOrders = [];
  let activeFilter = 'all';
  let activeOrderId = null;
  let activeItems = [];
  // grn counts cache: { orderId: count }
  const grnCounts = {};
  // order quantities summary: { orderId: { total_ordered, total_received, total_pending } }
  const orderSummaries = {};

  document.addEventListener('DOMContentLoaded', loadOrders);

  async function loadOrders() {
    try {
      const [r1, r2, r3] = await Promise.all([
        fetch('/api/orders/search/filter?status=sent',      { credentials:'include' }),
        fetch('/api/orders/search/filter?status=receiving', { credentials:'include' }),
        fetch('/api/security/orders-summary',               { credentials:'include' })
      ]);
      const pending   = r1.ok ? await r1.json() : [];
      const receiving = r2.ok ? await r2.json() : [];
      const summaries = r3.ok ? await r3.json() : [];

      summaries.forEach(s => {
        orderSummaries[s.order_id] = s;
      });

      document.getElementById('cnt-pending').textContent   = pending.length;
      document.getElementById('cnt-receiving').textContent = receiving.length;

      allOrders = [
        ...pending.map(o   => ({ ...o, tabStatus:'pending' })),
        ...receiving.map(o => ({ ...o, tabStatus:'receiving' }))
      ];

      // Load GRN counts for receiving orders
      await Promise.all(receiving.map(async o => {
        try {
          const res = await fetch(`/api/security/grns/${o.id}`, { credentials:'include' });
          const grns = res.ok ? await res.json() : [];
          grnCounts[o.id] = grns.length;
        } catch { grnCounts[o.id] = 0; }
      }));

      renderTable();
    } catch (err) {
      console.error(err);
      showToast('Failed to load orders', true);
    }
  }

  function setFilter(f) {
    activeFilter = f;
    ['all','pending','receiving'].forEach(k => {
      document.getElementById('fb-'+k).classList.toggle('active', k === f);
    });
    renderTable();
  }

  function renderTable() {
    const search = document.getElementById('search-inp').value.toLowerCase();
    const tbody  = document.getElementById('order-tbody');

    const filtered = allOrders.filter(o => {
      const poStr = (o.po_number || o.purchase_order_number || o.order_id || '').toLowerCase();
      const matchFilter = activeFilter === 'all' || o.tabStatus === activeFilter;
      const matchSearch = !search ||
        poStr.includes(search) ||
        (o.supplier||'').toLowerCase().includes(search);
      return matchFilter && matchSearch;
    });

    if (!filtered.length) {
      tbody.innerHTML = `<tr><td colspan="11"><div class="empty"><i class="fas fa-box-open"></i>No orders found.</div></td></tr>`;
      return;
    }

    tbody.innerHTML = filtered.map((o, i) => {
      const po_number = o.po_number || o.purchase_order_number || 'N/A';
      const isPending = o.tabStatus === 'pending';
      const date = o.created_at ? new Date(o.created_at).toLocaleDateString('en-IN') : '-';
      const amt  = '₹' + Number(o.total_amount||0).toLocaleString('en-IN');
      const statusBadge = isPending
        ? `<span class="badge badge-pending"><i class="fas fa-hourglass-half"></i> Pending</span>`
        : `<span class="badge badge-receiving"><i class="fas fa-truck-loading"></i> Receiving</span>`;

      const grnCell = isPending
        ? `<span style="color:var(--gray);font-size:.8rem">—</span>`
        : `<span class="grn-chip"><i class="fas fa-barcode"></i> ${grnCounts[o.id] || 0} GRN(s)</span>`;

      const summary = orderSummaries[o.id] || { total_received: 0, total_pending: 0 };
      const recQty = summary.total_received || 0;
      const pendQty = summary.total_pending !== undefined ? summary.total_pending : 0;

      const actions = isPending
        ? `<div class="actions">
             <button class="btn btn-primary" onclick="startReceiving(${o.id})"><i class="fas fa-play"></i> Start Receiving</button>
           </div>`
        : `<div class="actions">
             <button class="btn btn-primary"  onclick="openGrnModal(${o.id})"><i class="fas fa-plus"></i> Add GRN</button>
             <button class="btn btn-warning"  onclick="openHistModal(${o.id},'${esc(o.supplier||'')}')"><i class="fas fa-history"></i> History</button>
             <button class="btn btn-success"  onclick="completeOrder(${o.id})"><i class="fas fa-check-double"></i> Received</button>
             <button class="btn btn-gray"     onclick="revertToPending(${o.id})"><i class="fas fa-undo"></i> Pending</button>
           </div>`;

      return `<tr>
        <td style="color:var(--gray);font-size:.8rem">${i+1}</td>
        <td><strong>${esc(po_number)}</strong></td>
        <td>${esc(o.supplier||'-')}</td>
        <td><strong style="color:var(--success)">${recQty}</strong></td>
        <td><strong style="color:${pendQty > 0 ? '#d97706' : 'var(--gray)'}">${pendQty}</strong></td>
        <td style="max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${esc(o.project||'')}">${esc(o.project||'-')}</td>
        <td>${amt}</td>
        <td>${date}</td>
        <td>${statusBadge}</td>
        <td>${grnCell}</td>
        <td>${actions}</td>
      </tr>`;
    }).join('');
  }

  // ── Start Receiving ──────────────────────────────────────────────────────────
  async function startReceiving(orderId) {
    try {
      const res = await fetch(`/api/orders/${orderId}/receive`, { method:'PUT', credentials:'include' });
      if (!res.ok) return showToast('Failed to start receiving', true);
      showToast('Order moved to Now Receiving ✅');
      await loadOrders();
    } catch { showToast('Error', true); }
  }

  // ── Revert to Pending ────────────────────────────────────────────────────────
  async function revertToPending(orderId) {
    if (!confirm('Move this order back to Pending?\nAny GRNs already saved will remain.')) return;
    try {
      const res = await fetch(`/api/security/revert/${orderId}`, { method:'PUT', credentials:'include' });
      if (!res.ok) return showToast('Failed to revert order', true);
      showToast('Order moved back to Pending ↩️');
      await loadOrders();
    } catch { showToast('Error', true); }
  }

  // ── Add GRN Modal ────────────────────────────────────────────────────────────
  async function openGrnModal(orderId) {
    activeOrderId = orderId;
    document.getElementById('grn-title').textContent = 'Add GRN — Select Items & Quantities';
    const body = document.getElementById('grn-body');
    body.innerHTML = '<div style="text-align:center;padding:2rem"><div class="spinner"></div></div>';
    document.getElementById('grnModal').classList.add('open');

    try {
      const res = await fetch(`/api/security/order-items/${orderId}`, { credentials:'include' });
      if (!res.ok) throw new Error();
      activeItems = await res.json();

      if (!activeItems.length) {
        body.innerHTML = '<p style="color:var(--gray)">No items found for this order.</p>';
        return;
      }

      body.innerHTML = `
        <p style="margin-bottom:1rem;color:var(--gray);font-size:.88rem">
          <i class="fas fa-info-circle"></i> Select the items being received now and enter the quantity.
        </p>
        <table class="itbl">
          <thead><tr><th>✓</th><th>Description</th><th>Part No.</th><th>Ordered</th><th>Already Received</th><th>Pending</th><th>Now Receiving</th></tr></thead>
          <tbody>
            ${activeItems.map((item, i) => {
              const maxVal = item.pending_qty !== undefined ? item.pending_qty : item.ordered_qty;
              const isDone = maxVal <= 0;
              return `
              <tr style="${isDone ? 'opacity:0.65;background:#f9fafb;' : ''}">
                <td><input type="checkbox" class="item-chk" data-idx="${i}" onchange="toggleQty(this,${i})" ${isDone ? 'disabled' : ''}></td>
                <td>${esc(item.description||'')} ${isDone ? '<span class="badge badge-receiving" style="font-size:0.7rem;margin-left:4px;">Fully Received</span>' : ''}</td>
                <td>${esc(item.part_no||'-')}</td>
                <td>${item.ordered_qty||0} ${esc(item.unit||'')}</td>
                <td><strong style="color:var(--success)">${item.received_qty||0}</strong></td>
                <td><strong style="color:${maxVal > 0 ? '#d97706' : 'var(--gray)'}">${maxVal}</strong></td>
                <td>
                  <input type="number" id="qty-${i}" class="qty-inp" min="1" max="${maxVal}" value="${maxVal > 0 ? maxVal : 0}" ${isDone ? 'disabled' : 'disabled'}>
                  <div style="font-size:.72rem;color:var(--gray);text-align:center">Max: ${maxVal}</div>
                </td>
              </tr>`;
            }).join('')}
          </tbody>
        </table>
        <div style="text-align:right">
          <button class="btn btn-success" id="save-grn-btn" onclick="saveGrn()" disabled>
            <i class="fas fa-save"></i> Save GRN
          </button>
        </div>`;

      document.querySelectorAll('.item-chk').forEach(cb => cb.addEventListener('change', updateSaveBtn));
    } catch {
      body.innerHTML = '<p style="color:var(--danger)">Failed to load items.</p>';
    }
  }

  function toggleQty(cb, i) {
    document.getElementById(`qty-${i}`).disabled = !cb.checked;
    updateSaveBtn();
  }
  function updateSaveBtn() {
    const any = Array.from(document.querySelectorAll('.item-chk')).some(c => c.checked);
    document.getElementById('save-grn-btn').disabled = !any;
  }

  async function saveGrn() {
    const btn = document.getElementById('save-grn-btn');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';

    const items = [];
    document.querySelectorAll('.item-chk').forEach((cb, i) => {
      if (cb.checked) {
        const item = activeItems[i];
        items.push({
          item_id: item.id,
          description: item.description,
          ordered_qty: item.ordered_qty || item.quantity || 0,
          received_qty: parseInt(document.getElementById(`qty-${i}`).value) || 1
        });
      }
    });

    try {
      const res = await fetch('/api/security/grns', {
        method: 'POST',
        headers: { 'Content-Type':'application/json' },
        credentials: 'include',
        body: JSON.stringify({ purchase_order_id: activeOrderId, items })
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed');
      showToast(`GRN Created: ${data.grn_number} ✅`);
      grnCounts[activeOrderId] = (grnCounts[activeOrderId] || 0) + 1;
      closeGrn();
      await loadOrders();
    } catch (err) {
      showToast(err.message || 'Error saving GRN', true);
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-save"></i> Save GRN';
    }
  }

  function closeGrn() { document.getElementById('grnModal').classList.remove('open'); }

  // ── GRN History Modal ────────────────────────────────────────────────────────
  async function openHistModal(orderId, supplier) {
    document.getElementById('hist-title').textContent = `GRN History — ${supplier}`;
    const body = document.getElementById('hist-body');
    body.innerHTML = '<div style="text-align:center;padding:2rem"><div class="spinner"></div></div>';
    document.getElementById('histModal').classList.add('open');

    try {
      const res = await fetch(`/api/security/grns/${orderId}`, { credentials:'include' });
      const grns = res.ok ? await res.json() : [];

      if (!grns.length) {
        body.innerHTML = '<div class="empty"><i class="fas fa-inbox"></i>No GRNs created yet.</div>';
        return;
      }

      body.innerHTML = grns.map(g => `
        <div style="margin-bottom:1.25rem">
          <div style="display:flex;justify-content:space-between;align-items:center;padding:.65rem .9rem;background:#f8fafc;border:1.5px solid #e2e8f0;border-radius:8px;cursor:pointer"
               onclick="toggleDetail('d-${g.grn_number}',${orderId},'${g.grn_number}')">
            <span class="grn-chip" style="font-size:.9rem"><i class="fas fa-barcode"></i> ${esc(g.grn_number)}</span>
            <span style="color:var(--gray);font-size:.8rem">${new Date(g.created_at).toLocaleString('en-IN')}</span>
          </div>
          <div id="d-${g.grn_number}" style="display:none;margin-top:.4rem;padding:.75rem;background:#fff;border:1px solid #e2e8f0;border-radius:8px">
            <div style="text-align:center"><div class="spinner"></div></div>
          </div>
        </div>`).join('');
    } catch {
      body.innerHTML = '<p style="color:var(--danger)">Failed to load GRN history.</p>';
    }
  }

  async function toggleDetail(elemId, orderId, grnNumber) {
    const el = document.getElementById(elemId);
    if (el.style.display === 'none') {
      el.style.display = 'block';
      if (el.querySelector('.spinner')) {
        try {
          const res = await fetch(`/api/security/grns/${orderId}/${grnNumber}`, { credentials:'include' });
          const items = await res.json();
          el.innerHTML = items.length
            ? `<table class="itbl"><thead><tr><th>Description</th><th>Ordered Qty</th><th>Received Qty</th></tr></thead>
               <tbody>${items.map(it=>`<tr><td>${esc(it.description||'')}</td><td>${it.ordered_qty||0}</td><td><strong style="color:var(--success)">${it.received_qty||0}</strong></td></tr>`).join('')}</tbody></table>`
            : '<p style="color:var(--gray)">No items.</p>';
        } catch { el.innerHTML = '<p style="color:var(--danger)">Failed.</p>'; }
      }
    } else { el.style.display = 'none'; }
  }

  function closeHist() { document.getElementById('histModal').classList.remove('open'); }

  // ── Complete ─────────────────────────────────────────────────────────────────
  async function completeOrder(orderId) {
    if (!confirm('Mark this order as fully Received? This cannot be undone.')) return;
    try {
      const res = await fetch(`/api/security/complete/${orderId}`, { method:'PUT', credentials:'include' });
      if (!res.ok) return showToast('Failed to complete order', true);
      showToast('Order marked as Received ✅');
      await loadOrders();
    } catch { showToast('Error', true); }
  }

  // ── Utilities ────────────────────────────────────────────────────────────────
  function esc(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

  function showToast(msg, isError=false) {
    const t = document.getElementById('toast');
    t.innerHTML = `<i class="fas fa-${isError?'exclamation-triangle':'check-circle'}"></i> ${msg}`;
    t.className = `toast ${isError?'error':'success'} show`;
    setTimeout(() => t.className='toast', 4000);
  }

  function logout() {
    fetch('/logout',{method:'POST',credentials:'include'}).finally(()=>window.location.href='/');
  }

  document.getElementById('grnModal').addEventListener('click', e => { if(e.target.id==='grnModal') closeGrn(); });
  document.getElementById('histModal').addEventListener('click', e => { if(e.target.id==='histModal') closeHist(); });
</script>
</body>
</html>
